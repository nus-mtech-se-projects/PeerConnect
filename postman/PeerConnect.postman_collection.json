  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 on successful registration\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Returns UUID id\", () => {\r",
              "  pm.expect(pm.response.json().id).to.match(\r",
              "    /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i\r",
              "  );\r",
              "});\r",
              "pm.test(\"Returns correct email\", () => {\r",
              "  pm.expect(pm.response.json().email).to.eql(pm.environment.get(\"runEmail\"));\r",
              "});\r",
              "pm.test(\"Password not exposed\", () => {\r",
              "  const body = pm.response.json();\r",
              "  pm.expect(body).to.not.have.property(\"password\");\r",
              "  pm.expect(body).to.not.have.property(\"passwordHash\");\r",
              "});\r",
              "\r",
              "// Duplicate email check\r",
              "pm.test(\"409 on duplicate email\", (done) => {\r",
              "  pm.sendRequest({\r",
              "    url: pm.environment.get(\"baseUrl\") + \"/api/auth/register\",\r",
              "    method: \"POST\",\r",
              "    header: { \"Content-Type\": \"application/json\" },\r",
              "    body: {\r",
              "      mode: \"raw\",\r",
              "      raw: JSON.stringify({\r",
              "        nusStudentId: \"A9999999Z\",\r",
              "        firstName: \"Dupe\", lastName: \"Email\",\r",
              "        email: pm.environment.get(\"runEmail\"),\r",
              "        phone: \"98000000\",\r",
              "        password: pm.environment.get(\"testPassword\")\r",
              "      })\r",
              "    }\r",
              "  }, (err, res) => {\r",
              "    pm.expect(res).to.have.status(409);\r",
              "    pm.expect(res.json().error).to.eql(\"Email already registered\");\r",
              "    done();\r",
              "  });\r",
              "});\r",
              "\r",
              "// Duplicate NUS ID check\r",
              "pm.test(\"409 on duplicate NUS Student ID\", (done) => {\r",
              "  pm.sendRequest({\r",
              "    url: pm.environment.get(\"baseUrl\") + \"/api/auth/register\",\r",
              "    method: \"POST\",\r",
              "    header: { \"Content-Type\": \"application/json\" },\r",
              "    body: {\r",
              "      mode: \"raw\",\r",
              "      raw: JSON.stringify({\r",
              "        nusStudentId: pm.environment.get(\"runNusId\"),\r",
              "        firstName: \"Dupe\", lastName: \"NusId\",\r",
              "        email: \"unique-\" + Date.now() + \"@u.nus.edu.sg\",\r",
              "        phone: \"98000001\",\r",
              "        password: pm.environment.get(\"testPassword\")\r",
              "      })\r",
              "    }\r",
              "  }, (err, res) => {\r",
              "    pm.expect(res).to.have.status(409);\r",
              "    pm.expect(res.json().error).to.eql(\"NUS Student ID already registered\");\r",
              "    done();\r",
              "  });\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate unique identifiers per run\r",
              "pm.environment.set(\"runEmail\", \"test-\" + Date.now() + \"@u.nus.edu.sg\");\r",
              "pm.environment.set(\"runNusId\", \"T\" + Date.now().toString().slice(-7) + \"X\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nusStudentId\": \"{{runNusId}}\",\r\n  \"firstName\": \"Test\",\r\n  \"lastName\": \"User\",\r\n  \"email\": \"{{runEmail}}\",\r\n  \"phone\": \"91234567\",\r\n  \"password\": \"{{testPassword}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login with Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"200 on login with email\", () => {\r",
              "  pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Returns accessToken and fields\", () => {\r",
              "  const b = pm.response.json();\r",
              "  pm.expect(b.accessToken).to.be.a(\"string\").and.have.length.above(10);\r",
              "  pm.expect(b.id).to.be.a(\"string\");\r",
              "  pm.expect(b.expiresInSeconds).to.be.a(\"number\").and.above(0);\r",
              "  pm.environment.set(\"authToken\", b.accessToken);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{runEmail}}\",\r\n  \"password\": \"{{testPassword}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
