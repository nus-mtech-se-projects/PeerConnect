    {
      "name": "Microsoft OAuth Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const msIdToken = pm.environment.get(\"msIdToken\");\r",
              "\r",
              "if (!msIdToken) {\r",
              "  pm.test(\"Microsoft login skipped — no msIdToken configured\", () => {\r",
              "    pm.expect(true).to.be.true;\r",
              "  });\r",
              "} else {\r",
              "  pm.test(\"Microsoft login succeeds\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "  });\r",
              "  pm.test(\"Returns access token\", () => {\r",
              "    const body = pm.response.json();\r",
              "    pm.expect(body.accessToken).to.be.a(\"string\");\r",
              "    pm.environment.set(\"authToken\", body.accessToken);\r",
              "  });\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
