CREATE OR ALTER PROCEDURE dbo.usp_auth_get_user
  @username NVARCHAR(255)
AS
BEGIN
  SET NOCOUNT ON;

  DECLARE @u NVARCHAR(255) = LOWER(LTRIM(RTRIM(@username)));

  SELECT TOP (1)
      id, nus_student_id, first_name, last_name, email, phone,
      password_hash, user_type, status
  FROM dbo.[users]
  WHERE LOWER(email) = @u

  UNION ALL

  SELECT TOP (1)
      id, nus_student_id, first_name, last_name, email, phone,
      password_hash, user_type, status
  FROM dbo.[users]
  WHERE LOWER(nus_student_id) = @u
    AND NOT EXISTS (SELECT 1 FROM dbo.[users] WHERE LOWER(email) = @u);
END;

