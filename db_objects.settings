------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------

CREATE OR ALTER PROCEDURE dbo.usp_user_update_password
  @user_id       UNIQUEIDENTIFIER,
  @password_hash NVARCHAR(255)
AS
BEGIN
  SET NOCOUNT ON;

  IF (@password_hash IS NULL OR LEN(@password_hash) < 20)
    THROW 50002, 'Invalid password.', 1;

  UPDATE dbo.[users]
  SET password_hash = @password_hash,
      updated_at = SYSUTCDATETIME()
  WHERE id = @user_id
    AND status = 'active';

  IF (@@ROWCOUNT = 0)
    THROW 50003, 'User not found or not active.', 1;
END;

------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------

CREATE OR ALTER PROCEDURE dbo.usp_user_update_password_by_username
  @username      NVARCHAR(255),   -- email or nus_student_id
  @password_hash NVARCHAR(255)
AS
BEGIN
  SET NOCOUNT ON;

  DECLARE @u NVARCHAR(255) = LOWER(LTRIM(RTRIM(@username)));

  IF (@password_hash IS NULL OR LEN(@password_hash) < 20)
    THROW 50004, 'Invalid password.', 1;

  UPDATE dbo.[users]
  SET password_hash = @password_hash,
      updated_at = SYSUTCDATETIME()
  WHERE (email = @u OR nus_student_id = @u)
    AND status = 'active';

  IF (@@ROWCOUNT = 0)
    THROW 50005, 'User not found or not active.', 1;
END;

