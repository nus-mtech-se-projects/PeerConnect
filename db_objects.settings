------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------

CREATE OR ALTER PROCEDURE dbo.usp_user_create
  @nus_student_id NVARCHAR(20) = NULL,
  @first_name     NVARCHAR(255),
  @last_name      NVARCHAR(255),
  @email          NVARCHAR(255),
  @phone          NVARCHAR(20) = NULL,
  @password_hash  NVARCHAR(255),     -- bcrypt hash from backend
  @user_type      VARCHAR(20) = 'student'
AS
BEGIN
  SET NOCOUNT ON;

  -- Basic guard: hash should not be empty
  IF (@password_hash IS NULL OR LEN(@password_hash) < 20)
    THROW 50001, 'Invalid password hash.', 1;

  INSERT INTO dbo.[users]
  (
    nus_student_id, first_name, last_name, email, phone,
    password_hash, user_type, status, created_at, updated_at
  )
  OUTPUT inserted.id, inserted.email, inserted.nus_student_id, inserted.user_type, inserted.status
  VALUES
  (
    @nus_student_id, @first_name, @last_name, @email, @phone,
    @password_hash, @user_type, 'active', SYSUTCDATETIME(), SYSUTCDATETIME()
  );
END;

